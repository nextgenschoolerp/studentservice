  "item": [
    {
      "name": "US-03000: Enrollment & Permanent UID",
      "item": [
        {
          "name": "Enroll New Student (Generate Permanent UID)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{bearerToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"DPS-DELHI\",\n  \"branchId\": \"MAIN-01\",\n  \"firstName\": \"Aarav\",\n  \"lastName\": \"Sharma\",\n  \"dateOfBirth\": \"2015-05-14\",\n  \"gender\": \"MALE\",\n  \"bloodGroup\": \"O+\",\n  \"medicalAlerts\": \"Peanut allergy\",\n  \"emergencyContactPhone\": \"+919876543210\",\n  \"guardianName\": \"Rajesh Sharma\",\n  \"guardianRelationship\": \"Father\",\n  \"guardianPhone\": \"+919876543210\",\n  \"guardianEmail\": \"rajesh.sharma@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "students"]
            }
          }
        },
        {
          "name": "Get Student by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{bearerToken}}", "type": "text" }
