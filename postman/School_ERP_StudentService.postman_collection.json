              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "students", "{{studentId}}"]
            }
          }
        },
        {
          "name": "Get Student by Permanent UID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{bearerToken}}", "type": "text" }
